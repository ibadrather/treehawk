# Adapted from uv (https://github.com/astral-sh/uv), MIT OR Apache-2.0.
# See http://editorconfig.org for more information.
root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
insert_final_newline = true
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
max_line_length = 100
