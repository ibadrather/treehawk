<mxCell id="sampling-loop-24" value="deadlines are absolute, so a slow sample never pushes the next one late; a gap over 1.5 × interval is flagged &lt;b&gt;overrun&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontFamily=Urbanist;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DUrbanist;" vertex="1" parent="1"><mxGeometry x="120" y="132" width="560" height="44" as="geometry"/></mxCell>
<mxCell id="sampling-loop-25" value="&lt;b&gt;the loop ends when&lt;/b&gt;&lt;br&gt;• no process of the workload is left&lt;br&gt;• &lt;span style='font-family:Fira Code,monospace'&gt;--duration&lt;/span&gt; has elapsed&lt;br&gt;• Ctrl-C or SIGTERM asks it to stop&lt;br&gt;&lt;br&gt;&lt;b&gt;close(summary)&lt;/b&gt; runs in a &lt;span style='font-family:Fira Code,monospace'&gt;finally&lt;/span&gt; block, so a log always ends with a summary" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#0C0C0C;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=left;verticalAlign=middle;spacing=8;fontFamily=Urbanist;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DUrbanist;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="460" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
