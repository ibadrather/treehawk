<mxfile host="drawio"><diagram id="membership-rules-p0" name="membership-rules"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="membership-rules-2" value='&lt;b&gt;matcher&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#6B7280"&gt;names the workload&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;KEYWORD · --exact&lt;br&gt;--regex · --pid&lt;/span&gt;' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DCE9FA;strokeColor=#2A78D6;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="225" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="membership-rules-3" value="&lt;b style='font-size:16px'&gt;Tracker&lt;/b&gt;&lt;br&gt;&lt;br&gt;admits a process once&lt;br&gt;never evicts it&lt;br&gt;forgets it only when that exact&lt;br&gt;process exits &lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;(pid + start time)&lt;/span&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4531CC;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="195" width="270" height="180" as="geometry"/></mxCell>
<mxCell id="membership-rules-4" value="seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#6B7280;fontSize=12;fontColor=#6B7280;labelBackgroundColor=default;fontFamily=Helvetica;" edge="1" parent="1" source="membership-rules-2" target="membership-rules-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="membership-rules-5" value='&lt;b&gt;&lt;span style="font-family:monospace"&gt;tree&lt;/span&gt;&lt;/b&gt;&lt;br&gt;children and grandchildren, found by following parent links' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FCE4D9;strokeColor=#EB6834;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="330" height="115" as="geometry"/></mxCell>
<mxCell id="membership-rules-6" value="adopts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#6B7280;fontSize=12;fontColor=#6B7280;labelBackgroundColor=default;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="membership-rules-5" target="membership-rules-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="membership-rules-7" value='&lt;b&gt;&lt;span style="font-family:monospace"&gt;cgroup&lt;/span&gt;&lt;/b&gt;&lt;br&gt;anything inside a control group the workload owns: the one boundary a fork cannot escape' style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D5F2E6;strokeColor=#1BAF7A;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="155" width="330" height="115" as="geometry"/></mxCell>
<mxCell id="membership-rules-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#6B7280;fontSize=12;fontColor=#6B7280;labelBackgroundColor=default;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="membership-rules-7" target="membership-rules-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="membership-rules-9" value="&lt;b&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;session&lt;/span&gt;&lt;/b&gt;&lt;br&gt;processes re-parented away that kept the workload's session" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D5F2E6;strokeColor=#1BAF7A;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="330" height="115" as="geometry"/></mxCell>
<mxCell id="membership-rules-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#6B7280;fontSize=12;fontColor=#6B7280;labelBackgroundColor=default;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6000000000000001;entryDx=0;entryDy=0;" edge="1" parent="1" source="membership-rules-9" target="membership-rules-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="membership-rules-11" value="&lt;b&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;orphan&lt;/span&gt;&lt;/b&gt;&lt;br&gt;new since the last sample, lost its parent, and sits in a tracked process' cgroup" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D5F2E6;strokeColor=#1BAF7A;strokeWidth=1.5;fontSize=13;fontColor=#0C0C0C;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="425" width="330" height="115" as="geometry"/></mxCell>
<mxCell id="membership-rules-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;strokeColor=#6B7280;fontSize=12;fontColor=#6B7280;labelBackgroundColor=default;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="membership-rules-11" target="membership-rules-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="membership-rules-13" value="the rules run together each sample and repeat until nothing new turns up, so a cgroup adoption can reveal a whole subtree" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="395" width="330" height="64" as="geometry"/></mxCell>
